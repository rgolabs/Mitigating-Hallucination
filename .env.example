# Google Gemini API key used for running experiments, evaluation, and verification
GEMINI_API_KEY=your_gemini_api_key_here

# Kaggle API token for dataset downloading (if needed)
KAGGLE_API_TOKEN=your_kaggle_api_token_here

# Google Cloud AI Studio project details (optional/required depending on environment configurations)
AISTUDIO_PROJECT_NAME=projects/your_project_id_here
AISTUDIO_PROJECT_NUMBER=your_project_number_here
